---
layout: layouts/base.njk
---
<!-- Hero Section -->
<section class="hero-section overflow-hidden">
  <div class="container position-relative">
    <div class="row">
      <div class="col-12 position-relative m-0 p-0">
        <div class="bg-image-container animate-slide-in-left">
          <picture class="bg-image">
            <source media="(max-width: 575px)" srcset="{{ heroImage | replace('.jpg', '_phone.webp') }}" type="image/webp">
            <source media="(max-width: 575px)" srcset="{{ heroImage }}" type="image/jpeg">
            <source srcset="{{ heroImage | replace('.jpg', '.webp') }}" type="image/webp">
            <source srcset="{{ heroImage }}" type="image/jpeg">
            <img class="bg-image-img" src="{{ heroImage }}" alt="Personal Training Background" width="1320" height="665" loading="eager" fetchpriority="high">
          </picture>
        </div>
        <div class="text-overlay ptraining-text animate-slide-in-right bg-white bg-opacity-75 p-4 p-xxl-5">
          <h1 class="separator text-uppercase">
            <span class="d-block mb-2">
              <span><strong>{{ hero.title }}</strong></span>
            </span>
          </h1>
          <h4>
            <span class="d-block mb-3 fst-italic">
              {{ hero.subtitle }}
            </span>
          </h4>
          <p>{{ hero.text }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="sun-divider"><span class="sun"></span></div>

<!-- Tabs Section -->
<section class="py-5 gray-bg tab-section">
  <div class="custom-tabs">
    <ul class="nav nav-tabs justify-content-center border-0" id="personalTrainingTabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link px-4 active" id="tab-ptraining" data-bs-toggle="tab" data-bs-target="#ptraining" type="button" role="tab">Personal Training</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-4" id="tab-info" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">Practical Information</button>
      </li>
      <li class="nav-item">
        <button class="nav-link px-4" id="tab-pricing" data-bs-toggle="tab" data-bs-target="#pricing" type="button" role="tab">Prices</button>
      </li>
    </ul>
    <div class="tab-line"></div>
  </div>
  
  <div class="container">
    <div class="tab-content pt-3 mt-4" id="PersonalTrainingTabsContent" style="overflow:hidden">
      
      <!-- Personal Training Tab -->
      <div class="mb-3 tab-pane fade active show" id="ptraining" role="tabpanel">
        <h4 class="mt-4 mb-3 separator">{{ tab_intro.section1_title }}</h4>
        <h5 class="mb-3"><i>{{ tab_intro.section1_subtitle }}</i></h5>
        <div>{{ tab_intro.section1_text | safe }}</div>
        
        <h4 class="mt-5 mb-3 separator">{{ tab_intro.section2_title }}</h4>
        <h5 class="mb-3"><i>{{ tab_intro.section2_subtitle }}</i></h5>
        <div>{{ tab_intro.section2_text | safe }}</div>
      </div>

      <!-- Practical Information Tab -->
      <div class="mb-3 tab-pane fade" id="info" role="tabpanel">
        <h4 class="mt-4 mb-3 separator">{{ tab_info.title }}</h4>
        <div>{{ tab_info.intro_text | safe }}</div>
        
        <div class="row g-4">
          {% for step in tab_info.steps %}
          <div class="col-md-6 col-lg-6">
            <div class="card">
              <div class="card-body custom-color px-2 py-3 p-lg-5">
                <button class="btn toggle-btn w-100 d-flex justify-content-between align-items-center collapsed" data-bs-toggle="collapse" data-bs-target="#{{ step.id }}" aria-expanded="false">
                  <span class="card-title fs-4">
                    <span class="pe-2 pe-lg-3">{% include "icons/" ~ step.main_icon ~ ".njk" %}</span>{{ step.title }}
                  </span>
                  <span class="toggle-icon"></span>
                </button>
                <div class="collapse collapse-text" id="{{ step.id }}">
                  <div class="mt-2">
                    {{ step.description | safe }}
                    <ul class="mt-3 list-unstyled">
                      {% for feature in step.features %}
                      <li>{% include "icons/" ~ feature.icon ~ ".njk" %}<span>{{ feature.text }}</span></li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <!-- Pricing tab -->
      <div class="mb-3 tab-pane fade" id="pricing" role="tabpanel">
        <h4 class="mt-4 mb-3 separator">{{ tab_pricing.title }}</h4>
        <p>{{ tab_pricing.intro_text | safe }}</p>
        
        <div class="row g-4">
          {% for package in tab_pricing.packages %}
          <div class="col-md-6 col-lg-6">
            <div class="card">
              <div class="card-body custom-color p-4 p-lg-5">
                <h5 class="card-title text-center fs-4">{{ package.title }}</h5>
                <p class="card-text fs-lg-4 text-stacking">
                  {% include "icons/calendar-icon.njk" %}<span class="ps-2 ps-lg-3">{{ package.duration }}</span>
                </p>
                <p class="card-text fs-lg-4">
                  {% include "icons/user-icon.njk" %}<span class="ps-2 ps-lg-3 pe-4 pe-lg-5">{{ package.price_solo }}</span>
                  {% include "icons/users-icon.njk" %}<span class="ps-2 ps-lg-3">{{ package.price_duo }}</span>
                </p>
                <div class="card-text">
                  {% for item in package.features %}
                  <div class="text-stacking">
                    {% include "icons/check-icon.njk" %}<span class="ps-2 ps-lg-3">{{ item }}</span>
                  </div>
                  {% endfor %}
                  <button class="btn toggle-btn w-100 d-flex justify-content-center align-items-center collapsed" data-bs-toggle="collapse" data-bs-target="#{{ package.id }}">
                    <span class="fs-lg-4 visually-hidden">More Information</span>
                    <span class="toggle-icon"></span>
                  </button>
                  <div class="collapse collapse-text" id="{{ package.id }}">
                    <div class="mt-2">{{ package.more_info | safe }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  
  <div class="mt-3 text-center">
    <button id="prevTabBtn" class="btn custom-btn mx-3 fs-5" aria-label="Previous tab" disabled>{% include "icons/arrow-left-icon.njk" %}</button>
    <button id="nextTabBtn" class="btn custom-btn mx-3 fs-5" aria-label="Next tab">{% include "icons/arrow-right-icon.njk" %}</button>
  </div>
</section>