---
layout: layouts/base.njk
---
<!-- Home Section  -->
<header class="hero-home vh-100 d-flex align-items-center justify-content-center text-center pt-5">
  <picture class="hero-home-picture">
    <source media="(max-width: 1199px)" srcset="{{ heroImage | replace('.jpg', '_phone.webp') }}" type="image/webp">
    <source media="(max-width: 1199px)" srcset="{{ heroImage | replace('.jpg', '_phone.jpg') }}" type="image/jpeg">
    <source srcset="{{ heroImage | replace('.jpg', '.webp') }}" type="image/webp">
    <source srcset="{{ heroImage }}" type="image/jpeg">
    <img src="{{ heroImage }}" alt="Hero Background" class="hero-home-img" width="1920" height="1080" sizes="100vw" loading="eager" fetchpriority="high">
  </picture>
  <div class="container hero-home-content">
    <blockquote class="blockquote">
      <p class="fs-2 fst-italic">{{ quote.text | markdownInline | safe }}</p>
      <q class="blockquote-footer text-white">{{ quote.author }}</q>
    </blockquote>
  </div>
</header>

<div class="sun-divider white-bg"><span class="sun"></span></div>

<!-- Welcome Section -->
<section id="welcome" class="white-bg overflow-hidden">
  <div class="container position-relative">
    <div class="row">
      <div class="col-12 position-relative m-0 p-0">
        <div class="bg-image-container welcome-img animate-slide-in-left">
          <picture class="bg-image">
            <source media="(max-width: 575px)" srcset="{{ welcome.image | replace('.jpg', '_phone.webp') }}" type="image/webp">
            <source media="(max-width: 575px)" srcset="{{ welcome.image | replace('.jpg', '_phone.jpg') }}" type="image/jpeg">
            <source srcset="{{ welcome.image | replace('.jpg', '.webp') }}" type="image/webp">
            <source srcset="{{ welcome.image }}" type="image/jpeg">
            <img class="bg-image-img" src="{{ welcome.image }}" alt="Welcome Background" width="1320" height="665" loading="lazy">
          </picture>
        </div>
        <div class="text-overlay welcome-text animate-slide-in-right-welcome bg-white bg-opacity-75 p-4 p-xxl-5">
          <h1 class="separator-welcome text-uppercase">
            <span class="d-block mb-2">
              <span><strong>{{ welcome.title_part1 }}</strong></span>
            </span>
            <span class="d-block text-center mb-2">
              <strong>{{ welcome.title_part2 }}</strong>
            </span>
          </h1>
          <h4 class="mb-4 fst-italic">{{ welcome.subtitle | markdown | safe }}</h4>
          <div>{{ welcome.text | markdown | safe }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="sun-divider white-bg"><span class="sun"></span></div>

<!-- Coaching Services Section -->
<section class="py-5 gray-bg" id="services">
  <div class="container">
    <h2 class="mb-5 text-center separator-center">{{ services.title }}</h2>
    <div class="row">
      {% for card in services.cards %}
      <div class="col-lg-4 mb-4">
        <div class="card h-100">
          <picture class="card-img-top w-50 mx-auto mt-4">
            <source srcset="{{ card.image | replace('.png', '.webp') }}" type="image/webp">
            <source srcset="{{ card.image }}" type="image/png">
            <img src="{{ card.image }}" alt="{{ card.title }} Icon" width="208" height="208" loading="lazy">
          </picture>
          <div class="card-body custom-color">
            <h5 class="card-title text-uppercase text-center mb-4">{{ card.title }}</h5>
            <h6 class="mb-2 text-center separator-center">{{ card.subtitle }}</h6>
            <p class="card-text">{{ card.text }}</p>
          </div>
          <div class="card-footer text-center white-bg border-0">
            <a href="{{ links[card.link_key][locale] }}" class="btn custom-btn fs-5">{{ card.button_text }}</a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="sun-divider white-bg"><span class="sun"></span></div>

<!-- About Me Section -->
<section class="py-5 white-bg" id="about">
  <div class="container">
    <div class="row">
      <div class="col-lg-6">
        <h2 class="mb-5 separator">{{ about.title }}</h2>
        <div>{{ about.text | markdown | safe }}</div>
        <div class="text-center mt-3">
          <a href="{{ links[about.link_key][locale] }}" class="btn custom-btn fs-5">{{ about.button_text }}</a>
        </div>
      </div>
      <div class="col-lg-6 mt-4">
        <picture>
          <source srcset="{{ about.image | replace('.jpg', '.webp') }}" type="image/webp">
          <source srcset="{{ about.image }}" type="image/jpeg">
          <img class="img-fluid profile-img mx-lg-5 mt-3" src="{{ about.image }}" alt="{{ about.title }}" loading="lazy" width="450" height="600">
        </picture>
      </div>
    </div>
  </div>
</section>

<div class="sun-divider white-bg"><span class="sun"></span></div>

<!-- Reviews Section -->
<section class="py-5 gray-bg" id="reviews">
  <div class="container">
    <h2 class="mb-5 text-center">{{ reviews.title }}</h2>
    <div id="reviewsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="10000">
      <div class="carousel-inner px-5">
        {% for review in reviews.items %}
        <div class="carousel-item text-center {% if loop.first %}active{% endif %}">
          <h5 class="mb-3 separator-center">{{ review.title }}</h5>
          <blockquote class="blockquote">
            <p class="fst-italic">"{{ review.quote }}"</p>
            <footer class="blockquote-footer">{{ review.author }}</footer>
          </blockquote>
        </div>
        {% endfor %}
      </div>
      <button class="carousel-control-prev d-flex justify-content-start" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="prev" aria-label="Previous">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next d-flex justify-content-end" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="next" aria-label="Next">
        <span class="carousel-control-next-icon text-end" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="py-5 green-bg" id="contact">
  <div class="container d-flex justify-content-center align-items-center">
    <h2 class="mb-5 visually-hidden">{{ contact_section.title }}</h2>
      <div>
        <h4 class="separator-center">{{ contact_section.subtitle }}</h4>
        <p>
          {% include "icons/whatsapp-icon.njk" %}
          <a href="https://wa.me/{{ settings.phone }}" target="_blank" rel="noopener noreferrer">{{ settings.phoneText }}</a> 
        </p>
        <p>
          {% include "icons/email-icon.njk" %}
          <a href="mailto:{{ settings.email }}">{{ settings.emailText }}</a>
        </p>
        <p>
          {% include "icons/instagram-icon.njk" %}
          <a href="https://www.instagram.com/{{ settings.instagram }}" target="_blank" rel="noopener noreferrer">{{ settings.instagramText }}</a>
        </p>
      </div>
  </div>
  <div class="container">
    <div class="row justify-content-center mt-4">
      <div class="col-md-8">
        <form 
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          name="contact-form" class="needs-validation"
          novalidate
        >
          <input type="hidden" name="form-name" value="contact-form" />
          <div class="visually-hidden">
            <label>Don't fill this out if you're human:<input name="bot-field"></label>
          </div>
          <div class="mb-3">
            <label for="name" class="form-label">{{ form_section.labels.name }}</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="{{ form_section.placeholders.name }}" required>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">{{ form_section.labels.email }}</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="{{ form_section.placeholders.email }}" required>
          </div>
          <div class="mb-3">
            <label for="phone" class="form-label">{{ form_section.labels.phone }}</label>
            <input type="tel" class="form-control" id="phone" name="phone" placeholder="{{ form_section.placeholders.phone }}">
          </div>
          <div class="mb-3">
            <label for="message" class="form-label">{{ form_section.labels.message }}</label>
            <textarea class="form-control" id="message" name="message" rows="4" placeholder="{{ form_section.placeholders.message }}" required></textarea>
          </div>
          <div class="text-center">
            <button type="submit" class="btn custom-btn fs-5" aria-label="Send">{{ form_section.button }}</button>
          </div>
          <div id="form-message" class="text-center mt-3 p-3 rounded"></div>
        </form>
      </div>
    </div>
  </div>
</section>